{
  "name": "golinks-extension",
  "version": "1.0.0",
  "private": true,
  "description": "GoLinks browser extension for Chrome",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs --grant-hosts && playwright test",
    "extension-id": "node scripts/extension-id.mjs",
    "generate-key": "node scripts/generate-key.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.1.28",
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "jose": "^6.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
